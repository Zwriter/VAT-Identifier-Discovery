# Copy this file to .env (same folder) and fill in your values.
# .env is ignored by Git; never commit your real key.

# Brave Search API key (https://api-dashboard.search.brave.com) — used for finding company websites
BRAVE_API_KEY=

# Safety cap: the Brave backend stops after this many queries per run.
# The $5 monthly credit covers roughly 1,000 queries; keep this below that to avoid charges.
BRAVE_MAX_QUERIES=900

# Seconds between Brave queries (respects the per-second rate limit)
BRAVE_MIN_INTERVAL=1.1

# Seconds between requests to the same website when crawling company sites
CRAWL_DELAY=1.0

# How the crawler identifies itself to websites. Put a way to reach you (e.g. your GitHub repo URL).
CRAWLER_USER_AGENT=VATDiscoveryResearch/0.1 (personal research project; https://github.com/<you>/<repo>)
